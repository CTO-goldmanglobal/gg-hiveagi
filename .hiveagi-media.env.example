# HiveAGI Media Storage Configuration
#
# Large media files (stock pools, final videos, branding assets) live on the
# Goldman Global external drive, NOT in the git repo. This file tells the
# pipeline where to find them.
#
# Copy to .hiveagi-media.env and adjust if your drive path changes.

# External drive root (Goldman Global)
HIVEAGI_MEDIA_ROOT="/Volumes/Goldman Global/HiveAGI-Media"

# Subdirectories
HIVEAGI_FORGE_OUTPUT="${HIVEAGI_MEDIA_ROOT}/forge-output"
HIVEAGI_CLIP_POOLS="${HIVEAGI_MEDIA_ROOT}/clip-pools"
HIVEAGI_BRANDING="${HIVEAGI_MEDIA_ROOT}/branding-assets"
HIVEAGI_VAULT="${HIVEAGI_MEDIA_ROOT}/obsidian-vault"

# Default branding assets
ECH_LOGO="${HIVEAGI_BRANDING}/ExploreChina.png"
ECH_OUTRO="${HIVEAGI_BRANDING}/ech-ending-branding.mov"
