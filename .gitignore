*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/
.temp/

# Seed Output (但保留範例)
seed_output/
!seed_output/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# Misc
*.tmp
*.bak
*.orig

# Secrets / credentials — NEVER commit
.env
.env.*
!.env.example

# P2 runtime artifacts (local per-node state)
p2p_registry.json
p2p_registry.*.json

# Local LLM run output (real-mode test results — not for the repo)
real_entries/
real_quarantine/

# Auto-downloaded ML models (face detection .tflite etc.)
~/.hiveagi_models/
**/_anon/

# Obsidian plugin build artifacts / deps
obsidian_plugin/node_modules/
obsidian_plugin/main.js
obsidian_plugin/*.js.map
obsidian_plugin/dist/

# ZCode / agent internal artifacts
.zcode/

# Legal / privileged — never commit. Contains solicitor engagement briefs,
# opinions, risk assessments. Public disclosure may waive privilege.
legal/

# ECH VideoGen runtime output (per-run artifacts, not source)
explore_china_holiday/ech_output/

# VideoGen runtime output
videogen_output/

# Clip Pool — stock/human footage is never committed (re-fetchable cache).
# The pool_manifest.json is the durable record; .mp4 files are cache.
explore_china_holiday/tours/**/pool/

# HiveAGI media storage config (drive paths)
.hiveagi-media.env

# Tour video build artifacts (intermediate + final, regenerable)
explore_china_holiday/tours/**/output/
