# LLM Wiki Engine — environment template
# Copy to project root .env and fill in real values. DO NOT commit .env.

# Generator: MiniMax M3
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
# GroupId is an account identifier (not a secret on its own) but kept in env by convention.
MINIMAX_GROUP_ID=

# Auditor: DeepSeek V4 Flash
# Note: deepseek-chat / deepseek-reasoner were deprecated 2026-07-24.
#       Use deepseek-v4-flash (or deepseek-v4-pro).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Retry policy (spec §5)
MAX_RETRIES=2
RETRY_TEMP_INCREMENT=0.1
